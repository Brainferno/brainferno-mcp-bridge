# Port the in-app panel plugins connect back to.
ADOBE_CC_MCP_BRIDGE_PORT=7777

# Shared secret the panel must present when connecting.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADOBE_CC_MCP_BRIDGE_TOKEN=

# Milliseconds to wait for a script result before giving up.
ADOBE_CC_MCP_EVAL_TIMEOUT_MS=30000

# error | warn | info | debug
ADOBE_CC_MCP_LOG_LEVEL=info
