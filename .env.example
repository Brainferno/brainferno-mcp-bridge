# Port the in-app panel plugins connect back to (0 lets the OS choose).
# The handshake file below makes the real port discoverable regardless.
BRAINFERNO_MCP_BRIDGE_PORT=7897

# Shared secret the panel must present when connecting. Leave empty to have the
# server generate a random per-run token and publish it (with the port) to the
# handshake file, which the panels read. Set an explicit value to pin it.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRAINFERNO_MCP_BRIDGE_TOKEN=

# Set to 1 to DISABLE authentication and skip the handshake file. Local
# debugging only — never on a shared machine (the bridge runs arbitrary script).
BRAINFERNO_MCP_BRIDGE_INSECURE=

# Where the server writes the {port, token} handshake file panels read.
# Defaults to ~/.brainferno-mcp-bridge/bridge.json.
BRAINFERNO_MCP_HANDSHAKE_FILE=

# Extra comma-separated WebSocket Origins to accept on the bridge upgrade,
# beyond loopback origins and the no-Origin case (UXP panels send none). A web
# page's Origin is always a real web origin or "null", so both are rejected;
# add a panel's actual Origin here only if a spike shows it needs one.
BRAINFERNO_MCP_ALLOWED_ORIGINS=

# Milliseconds to wait for a "slow" script result before giving up.
BRAINFERNO_MCP_EVAL_TIMEOUT_MS=30000

# How often (ms) the bridge pings each panel to detect a dead connection.
BRAINFERNO_MCP_HEARTBEAT_MS=15000

# Set to 1 to register the raw ExtendScript escape-hatch tool (cc_eval_script).
# Off by default: it is arbitrary code execution at user privilege.
BRAINFERNO_MCP_ALLOW_RAW_SCRIPTS=

# Adobe's official Illustrator (Beta) MCP server, for the delegate lane
# (ai_beta_* tools: analyze / batch / export the open document). The key is
# copied from Illustrator > MCP & Tools; empty disables the delegate. It can
# also live in ~/.brainferno-mcp-bridge/config.json as {"illustratorKey": "ilst_..."}.
# Treat the key as a secret — regenerate it in Illustrator if it leaks.
BRAINFERNO_MCP_ILLUSTRATOR_KEY=
BRAINFERNO_MCP_ILLUSTRATOR_URL=http://localhost:18412/v1/mcp

# Which Illustrator the ai_* tools drive. macOS: an AppleScript name, a bundle id
# (com.adobe.illustrator, com.adobe.illustratorBeta) or an absolute .app path —
# pin it when the release and the Beta are both installed, since their bundles are
# both named "Adobe Illustrator.app" and a bare name follows whichever is running.
# Windows: a COM ProgID (e.g. Illustrator.Application.30). Empty = the app default.
BRAINFERNO_MCP_ILLUSTRATOR_APP=

# error | warn | info | debug
BRAINFERNO_MCP_LOG_LEVEL=info
