{
  "manifestVersion": 5,
  "id": "com.brainferno.adobe-cc-mcp.spike",
  "name": "adobe-cc-mcp spike",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "26.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridge",
      "label": {
        "default": "adobe-cc-mcp bridge (spike)"
      },
      "minimumSize": {
        "width": 240,
        "height": 200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 640
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light",
            "all"
          ],
          "species": [
            "chrome"
          ]
        }
      ],
      "maximumSize": {
        "width": 4000,
        "height": 4000
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
