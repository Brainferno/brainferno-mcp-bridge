{
  "manifestVersion": 5,
  "id": "com.brainferno.mcp-bridge.premiere",
  "name": "Brainferno MCP Bridge",
  "version": "0.2.2",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridge",
      "label": {
        "default": "Brainferno MCP Bridge"
      },
      "minimumSize": {
        "width": 240,
        "height": 200
      },
      "maximumSize": {
        "width": 4000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 640
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
