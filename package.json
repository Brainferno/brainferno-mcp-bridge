{
  "name": "adobe-cc-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for production After Effects, Premiere, Photoshop, Illustrator, and Audition",
  "type": "module",
  "bin": { "adobe-cc-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
